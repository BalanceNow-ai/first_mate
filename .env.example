# =============================================================================
# Helm — LOCAL acceptance stack configuration (docker-compose.yml)
#
#   cp .env.example .env && scripts/local_stack.sh up
#
# Every value below is a LOCAL-ONLY default: the stack runs on internal Docker networks
# with only 127.0.0.1:18080 (web) and 127.0.0.1:18025 (Mailpit UI) published. Never
# reuse these values anywhere else. Production uses .env.prod (see .env.prod.example).
# docker-compose.yml reads each required value with ${VAR:?}, so a missing one stops
# `docker compose` with a message instead of starting a half-configured stack.
# Passwords are embedded in connection URLs: keep them URL-safe (letters/digits).
# =============================================================================

# --- Compose -------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=helm
# Public origin of the local proxy (web + /api + /auth/v1). Must match HELM_WEB_PORT.
HELM_PUBLIC_URL=http://localhost:18080
# Optional: extra browser origins allowed by the API (comma-separated), e.g. a
# separately served Flutter dev build. Defaults to HELM_PUBLIC_URL.
# ALLOWED_ORIGINS=http://localhost:18080,http://localhost:18431
HELM_WEB_PORT=18080
HELM_MAIL_UI_PORT=18025
HELM_BIND_ADDRESS=127.0.0.1
# Subnet of the internal proxy network; the API trusts X-Forwarded-* only from it.
# Change it if it overlaps a network on your machine.
HELM_EDGE_SUBNET=10.247.80.0/24
# Optional: extra CA bundle for image builds behind a TLS-intercepting proxy.
# HELM_BUILD_CA_FILE=/path/to/ca-bundle.crt

# --- Application ---------------------------------------------------------------------
SECRET_KEY=local-development-secret-key-not-for-production-0001

# --- Database (container-internal) ---------------------------------------------------
POSTGRES_USER=helm
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=helm_db

# --- Local Supabase Auth (GoTrue) ------------------------------------------------------
# HS256 signing secret shared by GoTrue (issues tokens) and the API (verifies them).
# This is the server-only "legacy JWT secret" equivalent — never the anon key.
SUPABASE_JWT_SECRET=local-only-gotrue-jwt-secret-0123456789abcdef
# Password of the supabase_auth_admin role GoTrue uses for its own `helm_auth` database.
GOTRUE_DB_PASSWORD=localgotruepassword
# true  -> sign-up returns a session at once (no e-mail confirmation)
# false -> sign-up sends a confirmation e-mail to Mailpit and returns no session
GOTRUE_MAILER_AUTOCONFIRM=false
# Public anon key for the web client. Leave empty: scripts/local_stack.sh derives an
# HS256 `role=anon` key from SUPABASE_JWT_SECRET (the API refuses anon tokens).
SUPABASE_ANON_KEY=

# --- Search --------------------------------------------------------------------------
SEARCH_BACKEND=typesense
TYPESENSE_API_KEY=local-typesense-api-key

# --- Service-job private media (decisions SJ-D5, SJ-D6) --------------------------------
# Root credentials of the local VersityGW object store (S3 API, internal networks only;
# bucket `helm-private`, created by `scripts/local_stack.sh up`). The API signs browser
# download URLs for HELM_PUBLIC_URL (<= 5 minutes); the web proxy forwards /helm-private/
# to the gateway. Local values only — production uses a private bucket (.env.prod).
OBJECT_STORE_ACCESS_KEY=localobjectstorekey
OBJECT_STORE_SECRET_KEY=localobjectstoresecret0123456789
# Upload scanner: local_signature is a development/test substitute (EICAR + structural
# checks) and NOT a malware scanner; clamd needs a clamd daemon; disabled keeps every
# upload quarantined.
UPLOAD_SCANNER=local_signature

# --- Local substitutes (accepted only with APP_ENV=development/test, decision D5) -------
RATE_LIMIT_BACKEND=redis
PAYMENT_PROVIDER=local
AI_ENABLED=true
LLM_PROVIDER=local_extractive
EMBEDDING_PROVIDER=local_hash
CMS_PROVIDER=local_fixture
EMAIL_PROVIDER=smtp_sink
COURIER_RATE_MODE=rate_card
HELM_DASH_ENABLED=true

# --- Processes -----------------------------------------------------------------------
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
