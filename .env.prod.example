# =============================================================================
# Helm — PRODUCTION configuration (docker-compose.prod.yml, deploy/deploy.sh)
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod   # then fill in real values
#
# .env.prod is git-ignored and must never be committed. It is read twice:
#   * by `docker compose --env-file .env.prod` for ${VAR} interpolation (data stores,
#     proxy, image build args), and
#   * as `env_file` for the api / worker / beat / migrate containers (app settings).
# Variable names are the upper-cased fields of backend/app/config.py (Settings).
# deploy/deploy.sh refuses to deploy while a required value below is empty, and runs
# the application's own production validation before touching the database.
# Generate secrets with:  openssl rand -hex 32
# Keep POSTGRES_PASSWORD / REDIS_PASSWORD URL-safe (hex): they are embedded in URLs.
# =============================================================================

# --- Deployment ----------------------------------------------------------------------
# Public origin (scheme + host). The web build uses ${HELM_PUBLIC_URL}/api/v1.
HELM_PUBLIC_URL=https://app.example.co.nz
# Git ref deploy.sh requires to be checked out (branch name or tag).
HELM_DEPLOY_REF=main
# Directory holding fullchain.pem + privkey.pem (see deploy/certbot-deploy-hook.sh).
HELM_TLS_DIR=./deploy/certs
# Where deploy.sh writes pre-migration backups (outside the repo is better).
HELM_BACKUP_DIR=/var/backups/helm
# HELM_IMAGE_REPO=helm
# HELM_HTTP_PORT=80
# HELM_HTTPS_PORT=443
# HELM_EDGE_SUBNET=10.247.90.0/24

# --- Application ---------------------------------------------------------------------
APP_ENV=production
SECRET_KEY=
ALLOWED_ORIGINS=https://app.example.co.nz
PUBLIC_BASE_URL=https://app.example.co.nz
WEB_CONCURRENCY=3
CELERY_CONCURRENCY=2

# --- Database / cache (container-internal; URLs are built by the compose file) -------
POSTGRES_USER=helm
POSTGRES_PASSWORD=
POSTGRES_DB=helm_db
REDIS_PASSWORD=

# --- Supabase Auth (hosted project) ------------------------------------------------
# AUTH_MODE=jwks  : asymmetric signing keys (recommended); the API fetches
#                   ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# AUTH_MODE=hs256 : legacy shared secret; set SUPABASE_JWT_SECRET (server-only, from
#                   Project Settings -> JWT). NEVER the anon key.
AUTH_MODE=jwks
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Server-only. Used to confirm email verification at provisioning (Admin API). Required.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Stripe) -------------------------------------------------------------
# disabled until keys and the webhook endpoint
# (${HELM_PUBLIC_URL}/api/v1/payments/webhook) are configured in the Stripe dashboard.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Delivery ------------------------------------------------------------------------
# rate_card requires an explicit JSON rate card, e.g.
# [{"max_grams":1000,"price_cents":750},{"max_grams":5000,"price_cents":1290}]
COURIER_RATE_MODE=disabled
COURIER_RATE_CARD=
HELM_DASH_ENABLED=false
MAPBOX_ACCESS_TOKEN=

# --- AI (OpenAI) — leave disabled unless a key is configured ----------------------------
AI_ENABLED=false
LLM_PROVIDER=disabled
EMBEDDING_PROVIDER=disabled
OPENAI_API_KEY=

# --- Content -------------------------------------------------------------------------
CMS_PROVIDER=disabled
STRAPI_URL=
STRAPI_API_TOKEN=

# --- Search (Typesense, container-internal) ------------------------------------------
SEARCH_BACKEND=typesense
TYPESENSE_API_KEY=
TYPESENSE_SEARCH_ONLY_KEY=

# --- Notifications -------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@helmmarine.co.nz
PUSH_PROVIDER=disabled
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Storage -------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=helm-marine-assets
AWS_REGION=ap-southeast-2

# --- Service-job private media (REQUIRED; decisions SJ-D5, SJ-D6) ------------------------
# docker-compose.prod.yml refuses to start without these. Provision them yourself: a
# PRIVATE S3-compatible bucket (block public access, default encryption, HTTPS endpoint)
# and a clamd daemon reachable from api/worker. The API refuses local_fs, the
# local_signature scanner and signed URLs longer than 300 s in production.
OBJECT_STORE_BACKEND=s3
# Empty = AWS S3 for OBJECT_STORE_REGION. Set both for another S3-compatible provider;
# the public endpoint is the origin browsers use to fetch signed URLs.
OBJECT_STORE_ENDPOINT_URL=
OBJECT_STORE_PUBLIC_ENDPOINT_URL=
OBJECT_STORE_BUCKET=
OBJECT_STORE_REGION=ap-southeast-2
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
SIGNED_URL_SECONDS=300
UPLOAD_SCANNER=clamd
CLAMD_HOST=
CLAMD_PORT=3310

# --- Monitoring ----------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Public DSN compiled into the web build (optional).
SENTRY_DSN_WEB=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
